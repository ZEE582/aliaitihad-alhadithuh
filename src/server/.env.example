# Server Environment Configuration
PORT=26043
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Security & Authentication (Required: Must be a long 64+ char random string)
JWT_SECRET=your_secure_random_jwt_secret_key_64_characters_long
JWT_EXPIRATION=7d

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_NAME=kindergarten_db
DB_SSL=false
